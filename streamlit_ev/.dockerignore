# Local config with secrets (Terraform writes GITHUB_TOKEN into .env).
# Patterns here are matched from the build context root only, so `**/` is needed
# to also catch files in subdirectories such as app/.env.
**/.env
**/.env.*
!**/.env.example

# Local tooling and caches; the image installs its own virtualenv.
**/.venv/
**/venv/
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
**/.DS_Store
