project_id       = "your-project-id"
region           = "europe-west1"
location         = "EU"

# (Optional) Service Account JSON key for manual deployments
# credentials_file = "credentials.json"

# Cloud Function Source
function_source_dir = "../validator_src"

# BigQuery Settings
bq_schema_file         = "src/bq_schema/bq_schema.json"
EVENT_NAME_ATTRIBUTE   = "event_name"
EVENT_DATA_PATH        = "data"
LOG_VALID_FIELDS_FLAG  = true
LOG_PAYLOAD_WHEN_ERROR_FLAG = true
LOG_PAYLOAD_WHEN_VALID_FLAG = false

# Deletion Safeguards (Recommended for production)
deletion_protection   = true
force_destroy_buckets = false

# Scaling Configuration
backend_min_instances = 0
backend_max_instances = 10

# --- GitHub Integration (GitOps) (Optional) ---
# If left empty, GitOps synchronization will be disabled.
# github_token             = "ghp_xxxxxxxxxxxxxxxxxxx"  # PAT with 'repo' and 'workflow' scope
# schema_repo_owner        = "your-org"
# schema_repo_name         = "event-schemas"
# enable_branch_protection = false # Set to true if you have GitHub Pro or a Public repo
